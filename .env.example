# Copy this file to .env and fill in your keys. Never commit .env.

# Primary LLM: Gemini (free tier from Google AI Studio). Do NOT enable billing on this project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Fallback LLM: Groq (free tier from console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of origins allowed to call the API (your frontend URL)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Requests per minute allowed per visitor IP (protects your free quota)
RATE_LIMIT_PER_MIN=10

# Where the processed knowledge base and cache live
DATA_DIR=../data/processed
GRAMMAR_FILE=../data/grammar/n5_n4_grammar.json
CACHE_PATH=./cache.sqlite3
